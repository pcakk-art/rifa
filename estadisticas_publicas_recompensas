<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis estadísticas de entrenador</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      padding: 20px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: #1f2937;
    }
    .container {
      width: 100%;
      max-width: 980px;
      margin: 0 auto;
      background: #fff;
      border-radius: 22px;
      padding: 24px;
      box-shadow: 0 20px 60px rgba(0,0,0,.25);
    }
    .hero {
      text-align: center;
      padding: 18px 8px 24px;
    }
    .hero h1 {
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      margin-bottom: 8px;
    }
    .hero p { color: #64748b; line-height: 1.45; }
    .card {
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      border-radius: 18px;
      padding: 18px;
      margin: 16px 0;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
    }
    label { display: block; font-weight: 700; margin-bottom: 6px; color: #334155; }
    input {
      width: 100%;
      padding: 13px;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      font-size: 16px;
      background: #fff;
    }
    .btn {
      border: none;
      background: #667eea;
      color: #fff;
      padding: 13px 18px;
      border-radius: 12px;
      font-weight: 800;
      cursor: pointer;
      min-height: 48px;
    }
    .btn:hover { background: #5a67d8; }
    .btn-success { background: #16a34a; }
    .btn-success:hover { background: #15803d; }
    .actions { display:flex; gap:10px; flex-wrap:wrap; margin-top: 12px; }
    .metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }
    .metric {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 16px;
      text-align: center;
    }
    .metric strong {
      display: block;
      color: #2563eb;
      font-size: 2rem;
      margin-top: 6px;
    }
    .status {
      margin-top: 12px;
      padding: 12px;
      border-radius: 14px;
      background: #eff6ff;
      color: #1e40af;
      border: 1px solid #bfdbfe;
    }
    .pending {
      background: #fff7ed;
      color: #9a3412;
      border-color: #fed7aa;
    }
    .ok {
      background: #ecfdf5;
      color: #065f46;
      border-color: #a7f3d0;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 14px;
      overflow: hidden;
      margin-top: 12px;
    }
    th { background:#667eea; color:#fff; padding:12px; text-align:left; }
    td { padding:11px 12px; border-bottom:1px solid #e2e8f0; }
    .table-wrap { overflow-x:auto; }
  
    .top-rank {
      font-weight: 900;
      color: #2563eb;
    }
    .muted-code {
      color: #64748b;
      font-size: 0.9rem;
    }

  
    /* ============================================================
       TEMAS PÚBLICOS
       ------------------------------------------------------------
       La clase del body cambia según lo configurado por el admin.
       Cada tema usa una paleta inspirada en Pokémon, sin depender
       de imágenes externas.
    ============================================================ */
    body.theme-pikachu {
      background: linear-gradient(135deg, #facc15 0%, #f97316 100%);
    }
    body.theme-pokeball {
      background: linear-gradient(135deg, #ef4444 0%, #ef4444 48%, #111827 49%, #111827 53%, #f8fafc 54%, #e5e7eb 100%);
    }
    body.theme-bulbasaur {
      background: linear-gradient(135deg, #22c55e 0%, #14b8a6 100%);
    }
    body.theme-gengar {
      background: linear-gradient(135deg, #312e81 0%, #9333ea 100%);
    }
    .public-theme-hero {
      position: relative;
      overflow: hidden;
      border-radius: 20px;
      padding: 28px 18px;
      margin-bottom: 18px;
      color: #fff;
      background: linear-gradient(135deg, rgba(0,0,0,.25), rgba(0,0,0,.12));
      background-size: cover;
      background-position: center;
    }
    .public-theme-hero h1 {
      position: relative;
      z-index: 1;
      text-shadow: 0 2px 10px rgba(0,0,0,.25);
    }
    .public-theme-hero p {
      position: relative;
      z-index: 1;
      color: rgba(255,255,255,.92);
      text-shadow: 0 2px 8px rgba(0,0,0,.18);
    }

  </style>
</head>
<body>
  <div class="container">
    <div class="hero public-theme-hero" id="publicThemeHero">
      <h1 id="publicThemeTitleText">📊 Mis estadísticas</h1>
      <p id="publicThemeSubtitleText">Consulta tu avance con tu código de entrenador. Los registros hechos por admin aparecen incluso el mismo día.</p>
    </div>

    <div class="card">
      <label for="publicTrainerCode">Código de entrenador</label>
      <input id="publicTrainerCode" placeholder="Ej: 6011 3024 6134">
      <div class="actions">
        <button class="btn" onclick="loadMyStats()">🔎 Ver mis estadísticas</button>
      </div>
      <div id="publicStatus" class="status">Ingresa tu código para consultar tus registros.</div>
    </div>

    <div class="card" id="profileCard" style="display:none;">
      <h2>👤 Mis datos</h2>
      <p style="color:#64748b; margin:8px 0 14px;">Completa o actualiza tus datos para quedar registrado correctamente.</p>
      <div class="grid">
        <div>
          <label for="publicNick">Nick</label>
          <input id="publicNick" placeholder="Tu nick">
        </div>
        <div>
          <label for="publicName">Nombre real</label>
          <input id="publicName" placeholder="Nombre y apellido">
        </div>
        <div>
          <label for="publicContact">Contacto obligatorio</label>
          <input id="publicContact" placeholder="Teléfono, WhatsApp o correo">
        </div>
      </div>
      <div class="actions">
        <button class="btn btn-success" onclick="saveMyProfile()">💾 Guardar mis datos</button>
      </div>
    </div>

    <div class="card" id="statsCard" style="display:none;">
      <h2>🏆 Mi avance</h2>
      <div class="metrics">
        <div class="metric">Participaciones<strong id="myTotal">0</strong></div>
        <div class="metric">Eventos únicos<strong id="myEvents">0</strong></div>
        <div class="metric">Ranking general<strong id="myRank">-</strong></div>
        <div class="metric">Estado<strong id="myProfileState">-</strong></div>
      </div>

      <h3 style="margin-top:20px;">📅 Historial de eventos</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Evento</th>
              <th>Fecha evento</th>
              <th>Horario</th>
              <th>Fecha registro</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody id="myHistoryTable"></tbody>
        </table>
      </div>
    </div>

    <div class="card" id="top20Card">
      <h2>🏅 Top 20 asistencia</h2>
      <p style="color:#64748b; margin:8px 0 14px;">
        Ranking público según cantidad de participaciones registradas en eventos.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Posición</th>
              <th>Entrenador</th>
              <th>Eventos únicos</th>
              <th>Asistencias</th>
            </tr>
          </thead>
          <tbody id="publicTop20Table">
            <tr><td colspan="5" style="text-align:center; color:#64748b;">Cargando ranking...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    // ============================================================
    // PÁGINA PÚBLICA DE ESTADÍSTICAS
    // ------------------------------------------------------------
    // Los jugadores solo ven sus propios datos al ingresar código,
    // más un Top 20 general de asistencia sin herramientas admin.
    // ============================================================

    // Misma URL del Apps Script usado por la página admin.
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxod31sMOu8JD0KdAyQhFUVlyc2CD14dFYmIjSa1PUhV6Ks1K5zcSNWI9WgWG2U7rg_xQ/exec';


    // ============================================================
    // TEMA PÚBLICO
    // ============================================================
    // La página pública pide a Google Sheets la configuración visual
    // definida desde el panel admin. Si falla, usa tema Pikachu.

    function applyPublicTheme(themeConfig) {
      const config = themeConfig || {};
      const theme = config.theme || 'pikachu';

      document.body.classList.remove('theme-pikachu', 'theme-pokeball', 'theme-bulbasaur', 'theme-gengar');
      document.body.classList.add(`theme-${theme}`);

      const title = document.getElementById('publicThemeTitleText');
      const subtitle = document.getElementById('publicThemeSubtitleText');
      const hero = document.getElementById('publicThemeHero');

      if (title && config.title) title.textContent = config.title;
      if (subtitle && config.subtitle) subtitle.textContent = config.subtitle;

      if (hero && config.imageDataUrl) {
        hero.style.backgroundImage = `linear-gradient(rgba(0,0,0,.42), rgba(0,0,0,.34)), url('${config.imageDataUrl}')`;
      }
    }

    async function loadPublicTheme() {
      try {
        const response = await fetch(`${APPS_SCRIPT_URL}?accion=obtenerTemaPublico&t=${Date.now()}`);
        const data = await response.json();

        if (data.success) {
          applyPublicTheme(data.theme);
        } else {
          applyPublicTheme({ theme: 'pikachu' });
        }
      } catch (error) {
        console.warn('No se pudo cargar tema público:', error);
        applyPublicTheme({ theme: 'pikachu' });
      }
    }

    let publicData = { entrenadores: [], participantesEvento: [] };
    let currentCode = '';

    function normalizeTrainerCode(value) {
      const digits = String(value || '').replace(/\D/g, '');
      if (digits.length < 12) return '';
      const last12 = digits.slice(-12);
      return `${last12.slice(0,4)} ${last12.slice(4,8)} ${last12.slice(8,12)}`;
    }

    function setStatus(msg, type = '') {
      const el = document.getElementById('publicStatus');
      el.className = 'status ' + type;
      el.textContent = msg;
    }

    async function fetchPublicData() {
      const response = await fetch(`${APPS_SCRIPT_URL}?accion=obtenerEstadisticasJugadores&t=${Date.now()}`);
      const data = await response.json();
      if (!data.success) throw new Error(data.error || 'No se pudieron cargar datos');
      publicData = data;
    }

    function findTrainer(code) {
      const normalized = normalizeTrainerCode(code);
      return (publicData.entrenadores || []).find(t => normalizeTrainerCode(t.code) === normalized) || null;
    }

    function getRowsForCode(code) {
      const normalized = normalizeTrainerCode(code);
      return (publicData.participantesEvento || []).filter(p => normalizeTrainerCode(p.code) === normalized);
    }

    function calculateRank(code) {
      const map = new Map();
      (publicData.participantesEvento || []).forEach(p => {
        const c = normalizeTrainerCode(p.code);
        if (!c) return;
        map.set(c, (map.get(c) || 0) + 1);
      });
      const sorted = [...map.entries()].sort((a,b) => b[1] - a[1]);
      const idx = sorted.findIndex(([c]) => c === normalizeTrainerCode(code));
      return idx >= 0 ? idx + 1 : '-';
    }


    function maskCode(code) {
      const digits = String(code || '').replace(/\D/g, '');
      if (digits.length < 12) return '';
      return `${digits.slice(0,4)} **** ${digits.slice(8,12)}`;
    }

    // ============================================================
    // TOP 20 PÚBLICO
    // ============================================================
    // 1. Recorre todos los registros de participantes.
    // 2. Agrupa por código de entrenador.
    // 3. Cuenta asistencias totales y eventos únicos.
    // 4. Ordena de mayor a menor asistencia.
    // 5. Muestra solo los primeros 20.
    function renderPublicTop20() {
      const tbody = document.getElementById('publicTop20Table');
      if (!tbody) return;

      const map = new Map();

      (publicData.participantesEvento || []).forEach(p => {
        const code = normalizeTrainerCode(p.code);
        if (!code) return;

        if (!map.has(code)) {
          map.set(code, {
            code,
            total: 0,
            events: new Set()
          });
        }

        const item = map.get(code);
        item.total += 1;
        if (p.eventId) item.events.add(p.eventId);
      });

      const top = [...map.values()]
        .sort((a, b) => b.total - a.total || b.events.size - a.events.size)
        .slice(0, 20);

      if (!top.length) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:#64748b;">Aún no hay registros para mostrar</td></tr>';
        return;
      }

      tbody.innerHTML = '';

      top.forEach((item, index) => {
        const trainer = findTrainer(item.code);
        const displayName = trainer
          ? (trainer.nick || trainer.name || 'Entrenador registrado')
          : 'Entrenador pendiente';

        const row = tbody.insertRow();
        row.innerHTML = `
          <td class="top-rank">#${index + 1}</td>
          <td>
            <strong>${displayName}</strong><br>
            <span class="muted-code">${maskCode(item.code)}</span>
          </td>
          <td>${item.events.size}</td>
          <td><strong>${item.total}</strong></td>
        `;
      });
    }


    async function loadMyStats() {
      const code = normalizeTrainerCode(document.getElementById('publicTrainerCode').value);
      if (!code) {
        setStatus('Ingresa un código válido de 12 dígitos.', 'pending');
        return;
      }

      currentCode = code;
      setStatus('Cargando estadísticas...', '');

      try {
        await fetchPublicData();
        renderPublicTop20();

        const trainer = findTrainer(code);
        const rows = getRowsForCode(code);

        document.getElementById('profileCard').style.display = 'block';
        document.getElementById('statsCard').style.display = 'block';

        document.getElementById('publicTrainerCode').value = code;
        document.getElementById('publicNick').value = trainer ? trainer.nick : '';
        document.getElementById('publicName').value = trainer ? trainer.name : '';
        document.getElementById('publicContact').value = trainer ? trainer.contact : '';

        const events = new Set(rows.map(r => r.eventId).filter(Boolean));
        document.getElementById('myTotal').textContent = rows.length;
        document.getElementById('myEvents').textContent = events.size;
        document.getElementById('myRank').textContent = calculateRank(code);
        document.getElementById('myProfileState').textContent = trainer ? 'Completo' : 'Pendiente';

        const tbody = document.getElementById('myHistoryTable');
        tbody.innerHTML = rows.length ? '' : '<tr><td colspan="5" style="text-align:center; color:#64748b;">Aún no hay eventos registrados para este código</td></tr>';

        rows.sort((a,b) => new Date(b.registeredAt) - new Date(a.registeredAt)).forEach(r => {
          const row = tbody.insertRow();
          row.innerHTML = `
            <td>${r.eventName || r.eventId || '-'}</td>
            <td>${r.eventDate || '-'}</td>
            <td>${(r.eventStartTime || '--:--') + ' - ' + (r.eventEndTime || '--:--')}</td>
            <td>${r.registeredAt ? new Date(r.registeredAt).toLocaleString() : '-'}</td>
            <td>${trainer ? 'Completo' : 'Pendiente'}</td>
          `;
        });

        if (trainer) {
          setStatus(`Datos cargados para ${trainer.nick}.`, 'ok');
        } else {
          setStatus('Tu código tiene registros pendientes. Completa tus datos para quedar registrado.', 'pending');
        }

      } catch (error) {
        console.error(error);
        setStatus('No se pudo cargar la información. Intenta nuevamente.', 'pending');
      }
    }

    async function saveMyProfile() {
      if (!currentCode) {
        currentCode = normalizeTrainerCode(document.getElementById('publicTrainerCode').value);
      }

      const nick = document.getElementById('publicNick').value.trim();
      const name = document.getElementById('publicName').value.trim();
      const contact = document.getElementById('publicContact').value.trim();

      if (!currentCode || !nick || !name || !contact) {
        setStatus('Completa código, nick, nombre y contacto.', 'pending');
        return;
      }

      const profile = {
        code: currentCode,
        nick,
        name,
        contact,
        updatedAt: new Date().toISOString()
      };

      try {
        setStatus('Guardando datos...', '');

        await fetch(APPS_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            accion: 'guardarEntrenador',
            datos: JSON.stringify(profile)
          })
        });

        setStatus('Datos enviados correctamente. Actualizando estadísticas...', 'ok');
        setTimeout(loadMyStats, 1200);

      } catch (error) {
        console.error(error);
        setStatus('No se pudieron guardar los datos. Intenta nuevamente.', 'pending');
      }
    }

    document.addEventListener('DOMContentLoaded', async function() {
      loadPublicTheme();
      try {
        await fetchPublicData();
        renderPublicTop20();
      } catch (error) {
        const tbody = document.getElementById('publicTop20Table');
        if (tbody) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:#64748b;">No se pudo cargar el ranking</td></tr>';
        }
      }
    });

  
</script>
</body>
</html>
