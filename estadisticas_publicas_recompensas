<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Estadísticas públicas de jugadores</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
      color: #1e293b;
    }
    .container {
      width: min(1250px, 100%);
      margin: 0 auto;
      background: #fff;
      border-radius: 18px;
      padding: 28px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    }
    h1 { margin: 0 0 8px; text-align: center; color: #1e293b; }
    .subtitle { text-align:center; color:#64748b; margin-bottom: 24px; }
    .header-box {
      background: #eef2ff;
      border: 2px solid #c7d2fe;
      border-radius: 14px;
      padding: 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .filters, .kpis { display:grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap:16px; margin-bottom:20px; }
    .card {
      background: #fff;
      border: 2px solid #e2e8f0;
      border-radius: 14px;
      padding: 18px;
    }
    .kpi .value { font-size: 2rem; font-weight: 800; color:#4338ca; margin-top:6px; }
    label { display:block; margin-bottom:6px; color:#475569; font-weight:600; }
    input {
      width:100%; padding:12px; border-radius:10px; border:2px solid #cbd5e1; font-size:15px;
    }
    .layout { display:grid; grid-template-columns: 1.15fr 0.85fr; gap:20px; }
    .table-wrap { overflow:auto; border:2px solid #e2e8f0; border-radius: 12px; }
    table { width:100%; border-collapse:collapse; }
    th { background:#667eea; color:#fff; padding:12px; text-align:left; }
    td { padding:12px; border-bottom:1px solid #e2e8f0; vertical-align: top; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 1px; }
    .badge {
      display:inline-flex; align-items:center; gap:6px; padding:7px 11px; border-radius:999px;
      background:#fef3c7; color:#92400e; font-weight:700; margin:4px 6px 4px 0;
    }
    .history-list { display:flex; flex-direction:column; gap:12px; max-height:720px; overflow:auto; }
    .history-item {
      background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:14px;
    }
    .small { color:#64748b; font-size:0.92em; }
    .rank { font-weight:800; color:#4338ca; }
    @media (max-width: 980px) { .layout { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <div class="container">
    <h1>🏅 Estadísticas públicas de jugadores</h1>
    <div class="subtitle">Consulta el top 50, busca por entrenador, revisa tu historial y ve recompensas ganadas.</div>

    <div class="header-box">
      <div>
        <strong>Vista solo lectura</strong><br>
        <span class="small">Pensada para compartir con jugadores sin permisos de edición.</span>
      </div>
      <div class="small">Última carga: <span id="lastUpdate">-</span></div>
    </div>

    <div class="kpis">
      <div class="card kpi"><div>Jugadores únicos</div><div class="value" id="kpiPlayers">0</div></div>
      <div class="card kpi"><div>Registros totales</div><div class="value" id="kpiRecords">0</div></div>
      <div class="card kpi"><div>Eventos</div><div class="value" id="kpiEvents">0</div></div>
      <div class="card kpi"><div>Entrenadores</div><div class="value" id="kpiCoaches">0</div></div>
    </div>

    <div class="filters">
      <div class="card">
        <label for="coachFilter">Buscar por entrenador</label>
        <input id="coachFilter" type="text" placeholder="Ej: Coach Pablo" oninput="renderPublicView()">
      </div>
      <div class="card">
        <label for="playerFilter">Buscar jugador</label>
        <input id="playerFilter" type="text" placeholder="Nick o código" oninput="renderPublicView()">
      </div>
    </div>

    <div class="layout">
      <div class="card">
        <h3>🏆 Top 50</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Jugador</th>
                <th>Código</th>
                <th>Asistencias</th>
                <th>Entrenadores</th>
                <th>Recompensas</th>
              </tr>
            </thead>
            <tbody id="rankingTable"></tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <h3>🕘 Registros antiguos</h3>
        <div id="historyList" class="history-list"></div>
      </div>
    </div>
  </div>

  <script>
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxod31sMOu8JD0KdAyQhFUVlyc2CD14dFYmIjSa1PUhV6Ks1K5zcSNWI9WgWG2U7rg_xQ/exec';
    let statsData = { eventTemplate: { name:'', date:'', coach:'', location:'' }, events: [], records: [], rewards: [] };

    document.addEventListener('DOMContentLoaded', cargarDatos);

    function formatCode(code) {
      const digits = String(code || '').replace(/\D/g, '').slice(0, 12);
      return digits ? digits.replace(/(\d{4})(\d{0,4})(\d{0,4})/, (_, a, b, c) => [a,b,c].filter(Boolean).join(' ')) : '';
    }

    function normalizarStatsData(data) {
      const base = { eventTemplate: { name:'', date:'', coach:'', location:'' }, events: [], records: [], rewards: [] };
      if (!data || typeof data !== 'object') return base;
      base.eventTemplate = {
        name: String(data.eventTemplate?.name || '').trim(),
        date: String(data.eventTemplate?.date || '').trim(),
        coach: String(data.eventTemplate?.coach || '').trim(),
        location: String(data.eventTemplate?.location || '').trim()
      };
      base.events = Array.isArray(data.events) ? data.events : [];
      base.records = Array.isArray(data.records) ? data.records.map((r, idx) => ({
        id: r.id || `rec_${idx}`,
        eventId: r.eventId || '',
        eventName: String(r.eventName || '').trim(),
        eventDate: String(r.eventDate || '').trim(),
        coach: String(r.coach || '').trim(),
        nick: String(r.nick || '').trim(),
        code: formatCode(r.code || ''),
        createdAt: r.createdAt || new Date().toISOString()
      })).filter(r => r.nick && r.code) : [];
      base.rewards = Array.isArray(data.rewards) ? data.rewards : [];
      return base;
    }

    async function cargarDatos() {
      try {
        const res = await fetch(`${APPS_SCRIPT_URL}?accion=obtenerTodo`);
        const data = await res.json();
        statsData = normalizarStatsData(data.statsData || {});
        document.getElementById('lastUpdate').textContent = new Date().toLocaleString();
        renderPublicView();
      } catch (e) {
        document.getElementById('historyList').innerHTML = '<div class="history-item">No fue posible cargar los datos.</div>';
      }
    }

    function escapeHtml(text) {
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

function normalizeReward(raw) {
  return {
    id: raw.id || '',
    name: raw.name || 'Recompensa',
    icon: raw.icon || '🏆',
    criterion: raw.criterion || 'attendance_total',
    threshold: Math.max(1, Number(raw.threshold || 1)),
    coachTarget: raw.coachTarget || '',
    startDate: raw.startDate || '',
    endDate: raw.endDate || '',
    description: raw.description || '',
    active: raw.active !== false
  };
}

function getPlayerMetric(player, reward) {
  const history = [...(player.history || [])].filter(h => {
    const d = (h.eventDate || '').slice(0, 10);
    if (reward.startDate && d && d < reward.startDate) return false;
    if (reward.endDate && d && d > reward.endDate) return false;
    return true;
  });
  switch (reward.criterion) {
    case 'attendance_total': return history.length;
    case 'unique_events': return new Set(history.map(h => h.eventId)).size;
    case 'attendance_with_coach': {
      const q = (reward.coachTarget || '').trim().toLowerCase();
      return history.filter(h => !q || (h.coach || '').trim().toLowerCase() === q).length;
    }
    case 'distinct_coaches': return new Set(history.map(h => (h.coach || '').trim().toLowerCase()).filter(Boolean)).size;
    case 'attendance_since_date': return history.length;
    case 'streak_event_days': {
      const days = [...new Set(history.map(h => (h.eventDate || '').slice(0, 10)).filter(Boolean))].sort();
      let best = 0, current = 0, prev = null;
      for (const day of days) {
        if (!prev) current = 1;
        else {
          const diff = Math.round((new Date(day) - new Date(prev)) / 86400000);
          current = diff === 1 ? current + 1 : 1;
        }
        best = Math.max(best, current);
        prev = day;
      }
      return best;
    }
    default: return history.length;
  }
}

function getRewardCriterionLabel(reward) {
  switch (reward.criterion) {
    case 'attendance_total': return `Asistencias ≥ ${reward.threshold}`;
    case 'unique_events': return `Eventos únicos ≥ ${reward.threshold}`;
    case 'attendance_with_coach': return `Con ${reward.coachTarget || 'coach'} ≥ ${reward.threshold}`;
    case 'distinct_coaches': return `Coaches distintos ≥ ${reward.threshold}`;
    case 'attendance_since_date': return `Desde ${reward.startDate || 'fecha'} ≥ ${reward.threshold}`;
    case 'streak_event_days': return `Racha ≥ ${reward.threshold}`;
    default: return `Meta ≥ ${reward.threshold}`;
  }
}

function getPlayerSummaries() {
      const byCode = new Map();
      statsData.records.forEach(record => {
        const key = record.code;
        if (!byCode.has(key)) {
          byCode.set(key, {
            nick: record.nick,
            code: record.code,
            totalAttendances: 0,
            coaches: new Set(),
            history: []
          });
        }
        const entry = byCode.get(key);
        entry.nick = entry.nick || record.nick;
        entry.totalAttendances += 1;
        if (record.coach) entry.coaches.add(record.coach);
        entry.history.push(record);
      });

      return [...byCode.values()].map(entry => {
        const rewards = (statsData.rewards || []).filter(r => r.active !== false).filter(r => entry.totalAttendances >= Number(r.threshold || 1));
        return {
          nick: entry.nick,
          code: entry.code,
          totalAttendances: entry.totalAttendances,
          coaches: [...entry.coaches],
          history: entry.history.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt)),
          rewards
        };
      }).sort((a,b) => b.totalAttendances - a.totalAttendances || a.nick.localeCompare(b.nick, 'es'));
    }

    function renderPublicView() {
      const coachQ = (document.getElementById('coachFilter').value || '').trim().toLowerCase();
      const playerQ = (document.getElementById('playerFilter').value || '').trim().toLowerCase();
      const players = getPlayerSummaries().filter(player => {
        const coachOk = !coachQ || player.coaches.some(c => c.toLowerCase().includes(coachQ));
        const playerOk = !playerQ || player.nick.toLowerCase().includes(playerQ) || player.code.replace(/\s/g, '').includes(playerQ.replace(/\s/g, ''));
        return coachOk && playerOk;
      });

      document.getElementById('kpiPlayers').textContent = getPlayerSummaries().length;
      document.getElementById('kpiRecords').textContent = statsData.records.length;
      document.getElementById('kpiEvents').textContent = statsData.events.length;
      document.getElementById('kpiCoaches').textContent = new Set(statsData.records.map(r => r.coach).filter(Boolean)).size;

      const ranking = document.getElementById('rankingTable');
      if (!players.length) {
        ranking.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#64748b;">No hay resultados para este filtro</td></tr>';
      } else {
        ranking.innerHTML = players.slice(0, 50).map((player, idx) => `
          <tr>
            <td class="rank">${idx + 1}</td>
            <td><strong>${escapeHtml(player.nick)}</strong></td>
            <td class="mono">${escapeHtml(player.code)}</td>
            <td>${player.totalAttendances}</td>
            <td>${escapeHtml(player.coaches.join(', '))}</td>
            <td>${player.rewards.map(r => `<span class="badge" title="${escapeHtml(getRewardCriterionLabel(r))}">${escapeHtml(r.icon || '🏆')} ${escapeHtml(r.name || '')}</span>`).join('') || '-'}</td>
          </tr>
        `).join('');
      }

      const historyItems = players.flatMap(player => player.history.map(h => ({...h, playerRewards: player.rewards, nick: player.nick, code: player.code})))
        .sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt))
        .slice(0, 120);

      const historyWrap = document.getElementById('historyList');
      if (!historyItems.length) {
        historyWrap.innerHTML = '<div class="history-item">No hay registros antiguos para este filtro.</div>';
      } else {
        historyWrap.innerHTML = historyItems.map(item => `
          <div class="history-item">
            <strong>${escapeHtml(item.nick)}</strong> · <span class="mono">${escapeHtml(item.code)}</span><br>
            <span class="small">Evento: ${escapeHtml(item.eventName || '-')}</span><br>
            <span class="small">Entrenador: ${escapeHtml(item.coach || '-')}</span><br>
            <span class="small">Fecha del evento: ${escapeHtml(item.eventDate || '-')}</span><br>
            <span class="small">Registrado: ${new Date(item.createdAt).toLocaleString()}</span>
          </div>
        `).join('');
      }
    }
  </script>
</body>
</html>
